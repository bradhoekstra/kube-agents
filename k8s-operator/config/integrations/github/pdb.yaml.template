apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: github-token-minter
  labels:
    app: github-token-minter
spec:
  # Two replicas, so one can stay up through a node drain. The minter is on the
  # agent's write path to GitHub — every GitOps commit brokers a token through
  # it — and losing both pods at once fails those turns outright.
  #
  # minAvailable stays strictly below spec.replicas: at 2 it would allow zero
  # disruptions and block drains, which is `blocking-pdb` in
  # agents/platform/governance/obtainability_audit_sop.md §3.4.
  minAvailable: 1
  # Copied from the Deployment's own immutable spec.selector; §3.3 of that
  # audit matches a PDB to its workload by selector, never by name.
  selector:
    matchLabels:
      app: github-token-minter
